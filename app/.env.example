# 복사해서 .env 로 만든 뒤 사용한다: cp .env.example .env
# EC2에서는 DB_PASSWORD를 SSM Parameter Store에서 읽어 채운다 (Git에 올리지 않음)

# --- DB ---
# DB_HOST는 docker-compose.yml의 서비스 이름(db)
DB_HOST=db
DB_PORT=5432
DB_NAME=prices
DB_USER=app
DB_PASSWORD=change-me

# --- 수집 ---
COLLECT_INTERVAL_SECONDS=10
FETCH_TIMEOUT_SECONDS=5
UPBIT_BASE_URL=https://api.upbit.com
UPBIT_TICKER_PATH=/v1/ticker

# --- 장애 재현 (평소에는 아래 기본값 그대로) ---
# 외부 API 장애(http_error):  UPBIT_TICKER_PATH=/v1/ticker-wrong
# 데이터 장애(parse_error):   UPBIT_TICKER_PATH=/v1/market/all
# 앱 장애(5xx 급증):          FAULT_API_ERROR_RATE=0.3
FAULT_API_ERROR_RATE=0
